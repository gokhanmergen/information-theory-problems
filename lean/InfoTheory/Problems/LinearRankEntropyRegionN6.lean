import InfoTheory.Core

open scoped BigOperators

namespace InfoTheory.Problems.LinearRankEntropyRegionN6

/-- Closure of the convex cone generated by linear rank vectors on `n` subspaces over finite fields `GaloisField p r`
    (see `IsLinearRankVector`). -/
def InClosedLinearRankCone (n : ℕ) (h : Finset (Fin n) → ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ (k : ℕ) (v : Fin k → Finset (Fin n) → ℝ),
      (∀ j : Fin k, IsLinearRankVector n (v j)) ∧
      ∀ S : Finset (Fin n), |h S - ∑ j : Fin k, v j S| < ε

/-- Polyhedrality of the 6-variable closed linear rank cone `cl(L_6)` (Dougherty–Freiling–Zeger
    2009; Dougherty 2014): does there exist a finite family of linear rank inequalities
    completely characterizing `cl(L_6)`? (Known to be true for `n ≤ 5`; open for `n = 6`.) -/
def Statement : Prop :=
  ∃ (m : ℕ) (a : Fin m → Finset (Fin 6) → ℝ),
    ∀ (h : Finset (Fin 6) → ℝ),
      InClosedLinearRankCone 6 h ↔
        ∀ k : Fin m, 0 ≤ ∑ S : Finset (Fin 6), a k S * h S

def problem : OpenProblem where
  id := "linear-rank-entropy-region-n6"
  title := "Polyhedrality and Characterization of the Six-Variable Linear Rank Cone"
  category := .entropyInequalities
  status := .open
  posedBy := "Randall Dougherty, Chris Freiling, and Kenneth Zeger"
  posedYear := 2009
  statement := Statement

end InfoTheory.Problems.LinearRankEntropyRegionN6
