import InfoTheory.Core

open scoped BigOperators

namespace InfoTheory.Problems.FiniteStateChannelCapacity

/-- A Finite-State Channel (FSC) with input alphabet `Fin kX`, output alphabet `Fin kY`,
    and state space `Fin kS`, given by `W(y_t, s_t | x_t, s_{t-1})`. -/
structure FiniteStateChannel (kX kY kS : ℕ) where
  step : Fin kX → Fin kS → ProbDist (Fin kY × Fin kS)

/-- Marginal state-transition probability `P(s_N = sFinal | x^N, s_0)` after `N` steps. -/
noncomputable def stateReachProb {kX kY kS : ℕ} (W : FiniteStateChannel kX kY kS) :
    (N : ℕ) → (Fin N → Fin kX) → Fin kS → Fin kS → ℝ
  | 0, _, s₀, sF => if s₀ = sF then 1 else 0
  | N + 1, x, s₀, sF =>
      ∑ s₁ : Fin kS, (W.step (x 0) s₀).snd.pmf s₁ *
        stateReachProb W N (fun i => x i.succ) s₁ sF

/-- Gallager's (1968, Sec. 4.6) indecomposability condition for a finite-state channel:
    there exists `N ≥ 1` such that for every input block `x^N`, some state `s*` is reachable
    with positive probability from every initial state `s₀`. -/
def IsIndecomposable {kX kY kS : ℕ} (W : FiniteStateChannel kX kY kS) : Prop :=
  ∃ (N : ℕ), 1 ≤ N ∧
    ∀ (x : Fin N → Fin kX), ∃ (sStar : Fin kS), ∀ (s₀ : Fin kS),
      0 < stateReachProb W N x s₀ sStar

/-- Block transition probability `P(y^n | x^n, s_0)` summed over all intermediate states. -/
noncomputable def blockTrans {kX kY kS : ℕ} (W : FiniteStateChannel kX kY kS) :
    (n : ℕ) → (Fin n → Fin kX) → (Fin n → Fin kY) → Fin kS → ℝ
  | 0, _, _, _ => 1
  | n + 1, x, y, s₀ =>
      ∑ s₁ : Fin kS, (W.step (x 0) s₀).pmf (y 0, s₁) *
        blockTrans W n (fun i => x i.succ) (fun i => y i.succ) s₁

/-- Blocklength-`n` mutual information `I(X^n; Y^n | s_0)` in bits for input `P` on `X^n`. -/
noncomputable def fscBlockMI {kX kY kS : ℕ} (W : FiniteStateChannel kX kY kS)
    (n : ℕ) (s₀ : Fin kS) (P : ProbDist (Fin n → Fin kX)) : ℝ :=
  let py (y : Fin n → Fin kY) : ℝ :=
    ∑ x : Fin n → Fin kX, P.pmf x * blockTrans W n x y s₀
  let hY : ℝ := ∑ y : Fin n → Fin kY, negPLogP (py y)
  let hYgivenX : ℝ := ∑ x : Fin n → Fin kX, P.pmf x *
    ∑ y : Fin n → Fin kY, negPLogP (blockTrans W n x y s₀)
  hY - hYgivenX

/-- Best worst-initial-state mutual information `C_n(W) = sup_P inf_{s₀} I(X^n; Y^n | s₀)`
    at blocklength `n`. -/
noncomputable def fscMaxMinMI {kX kY kS : ℕ} (W : FiniteStateChannel kX kY kS) (n : ℕ) : ℝ :=
  sSup { m : ℝ | ∃ P : ProbDist (Fin n → Fin kX), ∀ s₀ : Fin kS, m ≤ fscBlockMI W n s₀ P }

/-- Non-feedback capacity `C(W) = liminf_{n → ∞} (1/n) sup_P min_{s₀} I(X^n; Y^n | s₀)`
    of an indecomposable FSC (equals `lim_{n → ∞}` by Gallager 1968, Theorem 4.6.1). -/
noncomputable def fscCapacity {kX kY kS : ℕ} (W : FiniteStateChannel kX kY kS) : ℝ :=
  sSup { r : ℝ | ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, 0 < N ∧ ∀ n : ℕ, N ≤ n →
    r - ε ≤ fscMaxMinMI W n / (n : ℝ) }

/-- A finite-order `M`-memory Markov input source on `Fin kX`: initial window distribution
    `init` on `(Fin M → Fin kX)` and transition kernel `trans` predicting the next symbol. -/
structure MarkovInput (kX M : ℕ) where
  init : ProbDist (Fin M → Fin kX)
  trans : (Fin M → Fin kX) → ProbDist (Fin kX)

/-- Probability of a length-`n` input block `x` generated by a memory-`M` Markov source
    (for `n ≥ M`). -/
noncomputable def markovBlockProb {kX M : ℕ} (Q : MarkovInput kX M) (n : ℕ) (hM : M ≤ n)
    (x : Fin n → Fin kX) : ℝ :=
  Q.init.pmf (fun j : Fin M => x ⟨j.1, Nat.lt_of_lt_of_le j.2 hM⟩) *
    ∏ t : Fin (n - M),
      (Q.trans (fun j : Fin M => x ⟨t.1 + j.1, by omega⟩)).pmf (x ⟨t.1 + M, by omega⟩)

/-- Asymptotic mutual information rate achieved by a memory-`M` Markov input source `Q`
    over an indecomposable FSC `W`. -/
noncomputable def fscMarkovRate {kX kY kS M : ℕ} (W : FiniteStateChannel kX kY kS)
    (Q : MarkovInput kX M) : ℝ :=
  sSup { r : ℝ | ∀ ε : ℝ, 0 < ε → ∃ (N : ℕ) (hMN : M ≤ N), ∀ (n : ℕ) (hN : N ≤ n),
    ∀ s₀ : Fin kS,
      let px (x : Fin n → Fin kX) : ℝ := markovBlockProb Q n (Nat.le_trans hMN hN) x
      let py (y : Fin n → Fin kY) : ℝ := ∑ x : Fin n → Fin kX, px x * blockTrans W n x y s₀
      let mi : ℝ := (∑ y : Fin n → Fin kY, negPLogP (py y)) -
        (∑ x : Fin n → Fin kX, px x * ∑ y : Fin n → Fin kY, negPLogP (blockTrans W n x y s₀))
      r - ε ≤ mi / (n : ℝ) }

/-- Finite-Memory Input Optimality Problem for Indecomposable Finite-State Channels
    (Gallager 1968; Vontobel–Arnold 2001; Permuter–Weissman–Goldsmith 2009):
    does every indecomposable finite-state channel achieve its exact non-feedback capacity
    using a finite-order Markov input source of some finite memory `M`? -/
def Statement : Prop :=
  ∀ (kX kY kS : ℕ), 1 ≤ kX → 1 ≤ kY → 1 ≤ kS →
    ∀ (W : FiniteStateChannel kX kY kS),
      IsIndecomposable W →
      ∃ (M : ℕ) (Q : MarkovInput kX M),
        fscMarkovRate W Q = fscCapacity W

def problem : OpenProblem where
  id := "finite-state-channel-capacity"
  title := "Finite-Memory Input Optimality for Indecomposable Finite-State Channels"
  category := .channelCapacity
  status := .open
  posedBy := "Robert G. Gallager; Haim H. Permuter, Tsachy Weissman, and Andrea J. Goldsmith"
  posedYear := 1968
  statement := Statement

end InfoTheory.Problems.FiniteStateChannelCapacity
